{
  "functions": {
    "api/notificar.js": {
      "maxDuration": 30
    },
    "api/nfce.js": {
      "maxDuration": 30
    },
    "api/recado.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/nota/:ref",
      "destination": "/api/nfce?v=:ref"
    }
  ],
  "redirects": [
    {
      "source": "/garcom.apk",
      "destination": "https://github.com/loreny17/Bavaro/releases/download/garcom-apk/garcom.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}